# Datos de tu proyecto Firebase (Project Settings > General > Tus apps > SDK setup).
# Copiá este archivo a ".env" y completá con los valores reales.
# El prefijo EXPO_PUBLIC_ es obligatorio: es lo que le dice a Expo que
# inyecte la variable en el código de la app (sin él, no llega al bundle).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
